<odoo>
    <record id="view_club_member_form" model="ir.ui.view">
        <field name="name">club.member.form</field>
        <field name="model">club.member</field>
        <field name="arch" type="xml">
            <form string="Club Member">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="university_id"/>
                        <field name="major"/>
                        <field name="track"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_club_member_tree" model="ir.ui.view">
        <field name="name">club.member.tree</field>
        <field name="model">club.member</field>
        <field name="arch" type="xml">
            <list string="Club Members">
                <field name="name"/>
                <field name="university_id"/>
                <field name="major"/>
                <field name="track"/>
            </list>
        </field>
    </record>

    <record id="action_club_members" model="ir.actions.act_window">
        <field name="name">Club Members</field>
        <field name="res_model">club.member</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_club_management_root" name="Club Management"/>
    <menuitem id="menu_club_members" name="Members"
              parent="menu_club_management_root"
              action="action_club_members"/>
</odoo>